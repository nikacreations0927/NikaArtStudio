# ─────────────────────────────────────────────────────────
#  Nika Arts Studio — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# Server
PORT=3000
BASE_URL=http://localhost:3000       # Change to your live domain after deployment
                                     # e.g. https://nikaartsstudio.com
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PGSSLMODE=require
PG_POOL_MAX=5
ADMIN_USERNAME=admin                 # Seeds the first admin user on first server start
ADMIN_PASSWORD=change-this-password  # Seeds the first admin password, stored hashed in Postgres
ADMIN_DISPLAY_NAME=Business Admin
ADMIN_API_KEY=change-this-secret     # Optional alternative for API tools/scripts
JWT_SECRET=change-this-customer-secret
ADMIN_SESSION_HOURS=12
CUSTOMER_SESSION_DAYS=30
PASSWORD_RESET_MINUTES=30
SHIPPING_FEE=99
FREE_SHIPPING_MINIMUM=2000

# ── PhonePe Payment Gateway ────────────────────────────────
# Get these from: https://dashboard.phonepe.com → Integrations
PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID_HERE
PHONEPE_SALT_KEY=YOUR_SALT_KEY_HERE
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox                  # Change to "production" when going live

# ── Shiprocket ─────────────────────────────────────────────
# Get these from: https://app.shiprocket.in → Settings → API
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary   # As configured in Shiprocket dashboard
SHIPROCKET_PICKUP_PINCODE=560001     # Your studio/warehouse pincode

# ── Store Info ─────────────────────────────────────────────
STORE_NAME=Nika Arts Studio
EMAIL_USER=your.nika.arts.email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Cloud image storage (free Cloudinary account)
# Create a free account at https://cloudinary.com, then copy these from Dashboard > API keys.
# When these are set, product image uploads go to Cloudinary instead of public/images/products.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_PRODUCT_FOLDER=nika-arts/products
CLOUDINARY_SITE_FOLDER=nika-arts/site
