{
  "name": "nika-arts-studio",
  "version": "1.0.0",
  "description": "E-commerce website for Nika Arts Studio",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "nodemon --exec \"node --no-warnings\" server.js",
    "upload:keychains": "node scripts/upload-keychain-images.js",
    "upload:site-assets": "node scripts/upload-site-assets.js",
    "db:migrate:sqlite": "node --no-warnings scripts/migrate-sqlite-to-postgres.js",
    "db:migrate:supabase-safe": "node --no-warnings scripts/migrate-sqlite-to-supabase-safe.js",
    "test:e2e:smoke": "node --no-warnings scripts/smoke-e2e.js",
    "admin:seed": "node scripts/seed-admin-user.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
